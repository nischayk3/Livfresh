rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin
    // For MVP: Check if phone ends with known admin phone numbers
    // TODO: Improve to read from /config/adminPhones dynamically
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.phone_number != null &&
             (request.auth.token.phone_number.hasSuffix('9108558715') || 
              request.auth.token.phone_number.hasSuffix('+919108558715'));
    }
    
    // Config collection - allow read for authenticated users (for admin phone check)
    // Write only for admins
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      // User can read/update their own profile, create if authenticated
      // Admin can read all users
      // For admin panel: Allow authenticated users to read users collection
      // (Admin check happens in application code via isAdminPhone)
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isOwner(userId) || isAdmin() || isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /orders/{orderId} {
        // User can access their own orders, admin can access all orders
        // For admin panel: Allow authenticated users to read all orders
        // (Admin check happens in application code)
        allow read: if isOwner(userId) || isAdmin() || isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }

      // Subscriptions - user can only access their own subscriptions
      match /subscriptions/{subscriptionId} {
        // Allow read/write if user owns the subscription or is admin
        // For admin panel: Allow authenticated users to read all subscriptions
        allow read: if isOwner(userId) || isAdmin() || isAuthenticated();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isOwner(userId) || isAdmin();
        
        // Credit usage subcollection
        match /creditUsage/{usageId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }
    }
    
    // Vendors collection
    match /vendors/{vendorId} {
      // Allow read for all authenticated users, write only for vendors/admins
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // ⚠️ In production, add vendor/admin check
      
      match /services/{serviceId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated(); // ⚠️ In production, add vendor/admin check
      }
      
      match /orders/{orderId} {
        // Admin can read/write all vendor orders
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() || isAdmin(); // ⚠️ In production, add vendor/admin check
      }
    }
  }
}
