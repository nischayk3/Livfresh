{
  "expo": {
    "name": "SpinZo",
    "slug": "Spinit",
    "scheme": [
      "spinzo",
      "com.nischayk3.Spinit-ios",
      "app-1-597897149776-ios-bc466d02099d18a135c055"
    ],
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/SpinZo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.nischayk3.Spinit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "newArchEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive_foreground_new.png",
        "backgroundImage": "./assets/ic_launcher_background.png",
        "backgroundColor": "#994BFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nischayk3.Spinit",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/SpinZo.png",
      "icon": "./assets/SpinZo.png",
      "backgroundColor": "#ffffff",
      "themeColor": "#994BFF",
      "description": "Premium Laundry & Fabricare Service"
    },
    "extra": {
      "eas": {
        "projectId": "e7863fff-8d0c-4d99-ae2c-93f59d2b2bdc"
      }
    },
    "plugins": [
      "./plugins/withDisablePngCrunching",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBFirestore",
              "firebase-ios-sdk"
            ]
          }
        }
      ],
      "./plugins/withFirebaseModularHeaders",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-font"
    ]
  }
}