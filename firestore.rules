rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        'phone_number' in request.auth.token && 
        request.auth.token.phone_number != null && (
          request.auth.token.phone_number.matches('.*(9661802634|9852030638|9108558715|8888888888)$') ||
          (exists(/databases/$(database)/documents/config/adminPhones) && 
           request.auth.token.phone_number.replace('\\+91', '') in get(/databases/$(database)/documents/config/adminPhones).data.adminPhones)
        );
    }

    // Helper function to check if a phone number is registered ops staff.
    // config/opsStaff.phones keys must be full E.164 (+91XXXXXXXXXX), matching the raw phone_number claim.
    function isOpsStaff() {
      return isAuthenticated() &&
        'phone_number' in request.auth.token &&
        request.auth.token.phone_number != null &&
        exists(/databases/$(database)/documents/config/opsStaff) &&
        request.auth.token.phone_number in get(/databases/$(database)/documents/config/opsStaff).data.phones;
    }

    // --- Collection Group Rules ---
    
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin() || isOpsStaff() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
      allow write: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
    }

    match /{path=**}/subscriptions/{subscriptionId} {
      allow read: if isAdmin() || isAuthenticated(); 
      allow write: if isAdmin();
    }

    // --- Regular Collection Rules ---
    
    match /config/{configId} {
      allow read: if configId == 'adminPhones' || configId == 'serviceAvailability' || configId == 'opsStaff' || isAdmin() || isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAdmin() || isOpsStaff() || isOwner(userId);
      allow update: if isAdmin() || isOwner(userId);
      
      match /addresses/{addressId} {
        allow read, write: if isAdmin() || isOwner(userId);
      }
      
      match /orders/{orderId} {
        allow read, write: if isAdmin() || isOwner(userId);
      }

      match /subscriptions/{subscriptionId} {
        allow read, create, update: if isAdmin() || isOwner(userId);
        allow delete: if isAdmin();
        
        match /creditUsage/{usageId} {
          allow read, create, update: if isAdmin() || isOwner(userId);
          allow delete: if isAdmin();
        }
      }

      match /notifications/{notifId} {
        allow read: if isAdmin() || isOwner(userId);
        allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if isAdmin();
      }
    }
    
    match /unserviceable_requests/{requestId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /services/{serviceId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      
      match /orders/{orderId} {
        allow read: if isAdmin() || isAuthenticated();
        allow write: if isAdmin() || isAuthenticated();
      }
    }

    match /daily_schedules/{date} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /ops_staff/{staffId} {
      allow read: if isOpsStaff();
      allow write: if isOpsStaff() && request.auth.uid == staffId;
    }

    match /ops_tasks/{taskId} {
      allow read: if isOpsStaff();
      allow write: if false;
    }

    match /ops_queue/{orderId} {
      allow read: if isOpsStaff();
      allow write: if false;
    }

    match /ops_process/{orderId} {
      allow read: if isOpsStaff();
      allow write: if false;
    }
  }
}
